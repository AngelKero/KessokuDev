---
// Header.astro - Cintillo Institucional CUCEA y Navegación Comercial Clara
---

<header class="sticky top-0 z-50 border-b border-[#1e293b] bg-[#080d1a]/95 backdrop-blur-md">
  <!-- Top Ticker / Institutional Trust Strip -->
  <div class="border-b border-[#1e293b]/60 bg-[#060911] px-4 py-2 text-xs font-mono-tech text-[#94a3b8]">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center text-[#10b981] font-semibold">
          <span class="mr-1.5 h-2 w-2 animate-pulse rounded-full bg-[#10b981]"></span>
          SISTEMA ACTIVO // 60 FPS
        </span>
        <span class="hidden text-[#475569] md:inline">•</span>
        <span class="hidden text-[#cbd5e1] md:inline">INICIATIVA CUCEA TECH // UDEG</span>
        <span class="hidden text-[#475569] md:inline">•</span>
        <span class="hidden text-[#d97706] lg:inline">SEDE: TORRE SMART CAMPUS (PISO 2)</span>
      </div>
      <div class="flex items-center space-x-3">
        <span class="text-[#f8fafc]">ESTADO: <span class="text-[#10b981] font-bold">DISPONIBLE</span></span>
        <span class="text-[#475569]">•</span>
        <span class="text-[#f59e0b]">4 CUPOS ESTA SEMANA</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="#" class="group flex items-center space-x-3 text-decoration-none">
      <div class="flex h-10 w-10 items-center justify-center rounded border border-[#1d4ed8] bg-[#0b1320] font-mono-tech font-bold text-[#f8fafc] shadow-inner transition-transform group-hover:scale-105">
        <span class="text-xs text-[#d97706]">KD</span>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <span class="font-bold tracking-tight text-white font-display text-lg">KESSOKU DEV</span>
          <span class="rounded bg-[#1d4ed8]/20 px-2 py-0.5 text-xs font-mono-tech text-[#93c5fd] border border-[#1d4ed8]/40">CUCEA UDEG</span>
        </div>
        <p class="text-xs font-mono-tech text-[#64748b]">DESARROLLO WEB & DIGITALIZACIÓN PARA PYMES</p>
      </div>
    </a>

    <!-- Nav Links in Clear Commercial Index Notation -->
    <nav class="hidden md:flex items-center space-x-8 text-xs font-mono-tech text-[#94a3b8]">
      <a href="#servicios" class="hover:text-white transition-colors flex items-center space-x-1">
        <span class="text-[#d97706]">01/</span>
        <span>SERVICIOS</span>
      </a>
      <a href="#garantias" class="hover:text-white transition-colors flex items-center space-x-1">
        <span class="text-[#10b981]">02/</span>
        <span>GARANTÍAS</span>
      </a>
      <a href="#paquetes" class="hover:text-white transition-colors flex items-center space-x-1">
        <span class="text-[#1d4ed8]">03/</span>
        <span>PAQUETES</span>
      </a>
      <a href="#cucea" class="hover:text-white transition-colors flex items-center space-x-1">
        <span class="text-[#cbd5e1]">04/</span>
        <span>SEDE CUCEA</span>
      </a>
    </nav>

    <!-- Header Action Button -->
    <div class="flex items-center space-x-3">
      <a 
        href="#diagnostico" 
        class="inline-flex items-center justify-center rounded border border-[#d97706] bg-[#d97706]/10 px-4 py-2.5 text-xs font-mono-tech font-bold text-[#f59e0b] hover:bg-[#d97706] hover:text-[#0b1320] transition-all active:translate-y-0.5"
      >
        <span class="mr-1.5">⚡</span> DIAGNÓSTICO $0
      </a>
    </div>
  </div>
</header>
