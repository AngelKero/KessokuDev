---
// FounderPalette.astro - Consola Instrumental de Acceso Rápido para Fundadores
const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;
---

<div 
  id="founder-palette-overlay" 
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-[#02050e]/85 backdrop-blur-md p-4 transition-opacity duration-200"
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="founder-palette-title"
>
  <div 
    id="founder-palette-card"
    class="relative w-full max-w-2xl rounded-2xl border border-[#1d4ed8]/60 bg-[#080d1a] shadow-[0_0_50px_rgba(29,78,216,0.3)] overflow-hidden transition-all transform scale-95 opacity-0"
  >
    <!-- Top Console Strip -->
    <div class="flex items-center justify-between border-b border-[#1e293b] bg-[#0c1427] px-5 py-3 text-xs font-mono-tech">
      <div class="flex items-center space-x-2">
        <span class="h-2 w-2 rounded-full bg-[#10b981] animate-pulse"></span>
        <span id="founder-palette-title" class="font-bold text-[#f8fafc] tracking-wider">CONSOLE // MODO FUNDADOR</span>
        <span class="rounded bg-[#1d4ed8]/20 px-2 py-0.5 text-[10px] text-[#93c5fd] border border-[#1d4ed8]/40">LTIN + LINI</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-[#64748b] text-[11px] hidden sm:inline">ACCESO AUTORIZADO</span>
        <button 
          id="close-palette-btn" 
          type="button" 
          class="rounded border border-[#334155] bg-[#1e293b]/60 px-2 py-0.5 text-[10px] text-[#94a3b8] hover:bg-[#334155] hover:text-white transition-colors"
          title="Cerrar modal (Esc)"
        >
          ESC ✕
        </button>
      </div>
    </div>

    <!-- Instruction Bar -->
    <div class="border-b border-[#1e293b]/60 bg-[#0a0f1d] px-5 py-2.5 text-xs text-[#94a3b8] flex items-center justify-between">
      <span>Accesos directos operacionales y herramientas internas de Kessoku Dev</span>
      <span class="text-[10px] font-mono-tech text-[#d97706]">VINCULACIÓN CUCEA</span>
    </div>

    <!-- Action Links List -->
    <div class="max-h-[65vh] overflow-y-auto p-4 space-y-2">
      <!-- 01: Hoja de Encargo B2B -->
      <a 
        href={`${baseUrl}encargo/`} 
        class="group flex items-start justify-between rounded-xl border border-[#1e293b] bg-[#0e1726]/60 p-3.5 transition-all hover:border-[#d97706] hover:bg-[#131f38] hover:shadow-[0_0_20px_rgba(217,119,6,0.15)]"
      >
        <div class="flex items-start space-x-3.5">
          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#d97706]/40 bg-[#d97706]/10 text-xs font-mono-tech font-bold text-[#f59e0b] group-hover:scale-105 transition-transform">
            01
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h4 class="text-sm font-bold text-white group-hover:text-[#f59e0b] transition-colors">
                Hoja de Encargo B2B (Exportar PDF / Imprimir)
              </h4>
              <span class="rounded bg-[#d97706]/20 px-1.5 py-0.5 text-[9px] font-mono-tech font-bold text-[#f59e0b] border border-[#d97706]/30">VENTAS</span>
            </div>
            <p class="mt-1 text-xs text-[#94a3b8] leading-relaxed">
              Contrato formal de 1 página: 50% anticipo, entrega en 5 días hábiles, selección de paquete y firma dual.
            </p>
          </div>
        </div>
        <span class="text-xs font-mono-tech text-[#64748b] group-hover:text-[#f59e0b] ml-2 shrink-0 transition-colors">Abrir ↗</span>
      </a>

      <!-- 02: Master Plan MVP 2026 -->
      <a 
        href={`${baseUrl}docs/mvp-estrategia/MASTER_PLAN_MVP_KESSOKU_DEV_2026.pdf`} 
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-start justify-between rounded-xl border border-[#1e293b] bg-[#0e1726]/60 p-3.5 transition-all hover:border-[#1d4ed8] hover:bg-[#131f38] hover:shadow-[0_0_20px_rgba(29,78,216,0.15)]"
      >
        <div class="flex items-start space-x-3.5">
          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#1d4ed8]/40 bg-[#1d4ed8]/10 text-xs font-mono-tech font-bold text-[#60a5fa] group-hover:scale-105 transition-transform">
            02
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h4 class="text-sm font-bold text-white group-hover:text-[#60a5fa] transition-colors">
                Master Plan MVP Kessoku Dev 2026 (PDF)
              </h4>
              <span class="rounded bg-[#1d4ed8]/20 px-1.5 py-0.5 text-[9px] font-mono-tech font-bold text-[#93c5fd] border border-[#1d4ed8]/30">ESTRATEGIA</span>
            </div>
            <p class="mt-1 text-xs text-[#94a3b8] leading-relaxed">
              Plan maestro de validación, arquitectura técnica multicliente a 60 FPS y estrategia de incubación en CUCEA.
            </p>
          </div>
        </div>
        <span class="text-xs font-mono-tech text-[#64748b] group-hover:text-[#60a5fa] ml-2 shrink-0 transition-colors">PDF ↗</span>
      </a>

      <!-- 03: Reporte Ecosistema CUCEA -->
      <a 
        href={`${baseUrl}docs/ecosistema-cucea/REPORTE_ECOSISTEMA_CUCEA_KESSOKU_DEV.pdf`} 
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-start justify-between rounded-xl border border-[#1e293b] bg-[#0e1726]/60 p-3.5 transition-all hover:border-[#10b981] hover:bg-[#131f38] hover:shadow-[0_0_20px_rgba(16,185,129,0.15)]"
      >
        <div class="flex items-start space-x-3.5">
          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#10b981]/40 bg-[#10b981]/10 text-xs font-mono-tech font-bold text-[#34d399] group-hover:scale-105 transition-transform">
            03
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h4 class="text-sm font-bold text-white group-hover:text-[#34d399] transition-colors">
                Reporte de Ecosistema e Incubadoras CUCEA (PDF)
              </h4>
              <span class="rounded bg-[#10b981]/20 px-1.5 py-0.5 text-[9px] font-mono-tech font-bold text-[#6ee7b7] border border-[#10b981]/30">VINCULACIÓN</span>
            </div>
            <p class="mt-1 text-xs text-[#94a3b8] leading-relaxed">
              Mapeo de Hospital PyME, IDITpyme, CIADEyS / CUCEA Emprende, Torre Smart Campus y perfil de decisores.
            </p>
          </div>
        </div>
        <span class="text-xs font-mono-tech text-[#64748b] group-hover:text-[#34d399] ml-2 shrink-0 transition-colors">PDF ↗</span>
      </a>

      <!-- 04: Repositorio GitHub -->
      <a 
        href="https://github.com/AngelKero/KessokuDev" 
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-start justify-between rounded-xl border border-[#1e293b] bg-[#0e1726]/60 p-3.5 transition-all hover:border-[#8b5cf6] hover:bg-[#131f38] hover:shadow-[0_0_20px_rgba(139,92,246,0.15)]"
      >
        <div class="flex items-start space-x-3.5">
          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#8b5cf6]/40 bg-[#8b5cf6]/10 text-xs font-mono-tech font-bold text-[#c084fc] group-hover:scale-105 transition-transform">
            04
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h4 class="text-sm font-bold text-white group-hover:text-[#c084fc] transition-colors">
                Repositorio Oficial GitHub (AngelKero/KessokuDev)
              </h4>
              <span class="rounded bg-[#8b5cf6]/20 px-1.5 py-0.5 text-[9px] font-mono-tech font-bold text-[#d8b4fe] border border-[#8b5cf6]/30">CÓDIGO</span>
            </div>
            <p class="mt-1 text-xs text-[#94a3b8] leading-relaxed">
              Repositorio de producción en Astro 5 con pipelines de despliegue automático en GitHub Pages.
            </p>
          </div>
        </div>
        <span class="text-xs font-mono-tech text-[#64748b] group-hover:text-[#c084fc] ml-2 shrink-0 transition-colors">Git ↗</span>
      </a>

      <!-- 05: Canal Directo Fundadores -->
      <a 
        href="https://wa.me/523318254823?text=Kessoku%20Dev%20//%20Consulta%20Operativa%20Interna%20Fundadores" 
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-start justify-between rounded-xl border border-[#1e293b] bg-[#0e1726]/60 p-3.5 transition-all hover:border-[#06b6d4] hover:bg-[#131f38] hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]"
      >
        <div class="flex items-start space-x-3.5">
          <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#06b6d4]/40 bg-[#06b6d4]/10 text-xs font-mono-tech font-bold text-[#22d3ee] group-hover:scale-105 transition-transform">
            05
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h4 class="text-sm font-bold text-white group-hover:text-[#22d3ee] transition-colors">
                Enlace Directo Fundadores (WhatsApp)
              </h4>
              <span class="rounded bg-[#06b6d4]/20 px-1.5 py-0.5 text-[9px] font-mono-tech font-bold text-[#67e8f9] border border-[#06b6d4]/30">OPERACIÓN</span>
            </div>
            <p class="mt-1 text-xs text-[#94a3b8] leading-relaxed">
              Contacto prioritario entre cofundadores para validación técnica de prospectos y dudas de alcance.
            </p>
          </div>
        </div>
        <span class="text-xs font-mono-tech text-[#64748b] group-hover:text-[#22d3ee] ml-2 shrink-0 transition-colors">Chat ↗</span>
      </a>
    </div>

    <!-- Bottom Controls & Hints -->
    <div class="border-t border-[#1e293b] bg-[#060a14] px-5 py-3 text-[11px] font-mono-tech text-[#64748b] flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center space-x-3">
        <span><kbd class="rounded border border-[#334155] bg-[#1e293b] px-1 py-0.5 text-[#f8fafc]">Cmd</kbd> + <kbd class="rounded border border-[#334155] bg-[#1e293b] px-1 py-0.5 text-[#f8fafc]">K</kbd> alternar</span>
        <span class="text-[#334155]">•</span>
        <span><kbd class="rounded border border-[#334155] bg-[#1e293b] px-1 py-0.5 text-[#f8fafc]">ESC</kbd> cerrar</span>
      </div>
      <div class="text-[#d97706] text-[10px]">
        <span>📱 En móvil: 3 toques sobre el logo "KD"</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Script de gestión de la Consola de Fundadores
  function initFounderPalette() {
    const overlay = document.getElementById('founder-palette-overlay');
    const card = document.getElementById('founder-palette-card');
    const closeBtn = document.getElementById('close-palette-btn');

    if (!overlay || !card) return;

    let isOpen = false;

    function openPalette() {
      isOpen = true;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      // Transición fluida
      requestAnimationFrame(() => {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
      });
    }

    function closePalette() {
      if (!isOpen) return;
      isOpen = false;
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        overlay.classList.remove('flex');
        overlay.classList.add('hidden');
      }, 150);
    }

    function togglePalette() {
      if (isOpen) {
        closePalette();
      } else {
        openPalette();
      }
    }

    // Cerrar con botón X
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closePalette();
    });

    // Cerrar haciendo clic en el backdrop
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closePalette();
      }
    });

    // Listener global de teclado
    window.addEventListener('keydown', (e) => {
      // Cmd+K (macOS) o Ctrl+K (Windows/Linux)
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        togglePalette();
      } else if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        closePalette();
      }
    });

    // Escuchar evento personalizado emitido por el gesto táctil del logo
    window.addEventListener('open-founder-palette', () => {
      openPalette();
    });
  }

  // Inicializar al cargar y ante transiciones de Astro
  document.addEventListener('DOMContentLoaded', initFounderPalette);
  document.addEventListener('astro:page-load', initFounderPalette);
</script>
